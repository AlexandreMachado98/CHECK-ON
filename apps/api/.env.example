# Copie para .env e preencha. Nunca faça commit do .env.

# ── Banco (Neon) ─────────────────────────────────────
# Crie o projeto Neon na região AWS us-east-1 (N. Virginia), a mesma da API no Render.
# Connection string COM pooling (host contém "-pooler"). Usada pela API.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.us-east-1.aws.neon.tech/checkon?sslmode=require&pgbouncer=true&connection_limit=5"
# Connection string DIRETA (sem "-pooler"). Usada pelo prisma migrate.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.us-east-1.aws.neon.tech/checkon?sslmode=require"

# ── Segurança ────────────────────────────────────────
# Obrigatória em produção, com pelo menos 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Validade da sessão do app (refresh token), em dias. Padrão: 30.
REFRESH_TOKEN_EXPIRES_DAYS=30
# Domínios do painel separados por vírgula. Obrigatória em produção.
CORS_ORIGINS=http://localhost:3000

# ── API ──────────────────────────────────────────────
PORT=3333
PUBLIC_API_URL=http://localhost:3333

# ── Armazenamento de fotos ───────────────────────────
# local: grava em ./uploads (desenvolvimento). s3: Cloudflare R2, AWS S3, Backblaze B2, MinIO.
STORAGE_DRIVER=local
UPLOADS_DIRECTORY=uploads
# Preencha quando STORAGE_DRIVER=s3
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=checkon-fotos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endereço público do bucket (domínio próprio ou URL pública do R2), sem barra no final
STORAGE_PUBLIC_URL=https://fotos.seudominio.com.br
S3_FORCE_PATH_STYLE=false

# ── Seed (apenas para criar o super admin em produção) ──
SEED_ADMIN_PASSWORD=
