generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: URL com pooling (-pooler no host) para a API
  url       = env("DATABASE_URL")
  // Neon: URL direta, usada pelo prisma migrate
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// TENANT MANAGEMENT
// ---------------------------------------------------------

model Tenant {
  id                  String    @id @default(uuid())
  name                String
  // Código da empresa no login por matrícula (ex.: "GAMA"): empresa + matrícula + senha
  code                String?   @unique
  cnpj                String?   @unique
  isActive            Boolean   @default(true)
  plan                String    @default("STARTER") // STARTER, PRO, ENTERPRISE
  storageUsed         BigInt    @default(0) // in bytes
  // Dados de contato exibidos em Configurações
  address             String?
  contactEmail        String?
  phone               String?
  // NC crítica ativa bloqueia o veículo automaticamente (desligado: o veículo fica em "Atenção")
  autoBlockCriticalNc Boolean   @default(true)
  // "Revogar todas as sessões": tokens emitidos antes deste instante deixam de valer
  sessionsRevokedAt   DateTime?
  // Assinatura (controlada pelo DDS Master): TESTE, MENSAL ou ANUAL.
  billingCycle        String    @default("MENSAL")
  // Vencimento da assinatura. Sem data: sem vencimento (empresas antigas e a da plataforma).
  subscriptionEndsAt  DateTime?
  // Dias depois do vencimento em que o acesso continua liberado, com aviso no portal.
  graceDays           Int       @default(5)
  // Anotações internas do DDS Master (não aparecem para a empresa).
  masterNotes         String?
  // Arquivada pelo DDS Master ("Excluir"): some das listas e ninguém entra, mas os dados ficam.
  // Restaurar volta ao normal; "Excluir definitivamente" só é aceito para empresa arquivada.
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users       User[]
  employees   Employee[]
  roles       Role[]
  departments Department[]
  units       Unit[]
  fleets      Fleet[]
  vehicles    Vehicle[]
  checklists  Checklist[]      @relation("TenantToChecklist")
  templates   Template[]
  ncs         NonConformity[]  @relation("TenantToNC")
  accessLogs  AdminAccessLog[]
  masterLogs  MasterAuditLog[]
  ncActions   NcAction[]
}

// ---------------------------------------------------------
// USERS AND RBAC
// ---------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  permissions String // e.g. ["checklist:create", "vehicle:read"]
  isSystem    Boolean  @default(false) // Super admin roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
}

model User {
  id                      String    @id @default(uuid())
  tenantId                String
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Opcional: quem não tem e-mail (ex.: motorista) entra com código da empresa + matrícula
  email                   String?   @unique
  passwordHash            String
  // Senha provisória (criada ou redefinida pela empresa): troca obrigatória no próximo login
  mustChangePassword      Boolean   @default(false)
  // Tokens emitidos antes da última troca de senha deixam de valer
  passwordChangedAt       DateTime?
  // Limite de tentativas: após 5 erros seguidos, login bloqueado até lockedUntil
  // Troca do próprio e-mail: o novo só vale depois de confirmado por código (válido por 15 min)
  pendingEmail            String?
  pendingEmailRequestedAt DateTime?
  failedLoginCount        Int       @default(0)
  lockedUntil             DateTime?
  name                    String
  isActive                Boolean   @default(true)
  roleId                  String
  role                    Role      @relation(fields: [roleId], references: [id])
  employeeId              String?   @unique
  employee                Employee? @relation(fields: [employeeId], references: [id])
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  refreshTokens RefreshToken[]
  accessLogs    AdminAccessLog[]
  units         UserUnit[]

  @@index([tenantId])
}

// Registro de cada vez que um super admin entra no painel de uma empresa cliente ("Acessar empresa").
/// Histórico das ações feitas pelo DDS Master (criar, renovar, trocar código, suspender...).
model MasterAuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  actor     String?
  details   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

model AdminAccessLog {
  id          String   @id @default(uuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// Sessões de longa duração (app mobile offline). Guarda só o hash SHA-256 do token.
/// Contador de tentativas (login por IP) compartilhado entre as instâncias da API.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Tokens renovados a partir do mesmo login compartilham a família (detecção de reuso)
  familyId  String
  // "app": sessão do aplicativo (login sem senha), limitada às rotas do app também na renovação
  channel   String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Employee {
  id                          String     @id @default(uuid())
  tenantId                    String
  tenant                      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matricula                   String?
  name                        String
  jobTitle                    String?
  admissionDate               DateTime?
  departmentName              String?
  supervisorId                String?
  supervisor                  Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports               Employee[] @relation("EmployeeSupervisor")
  photoUrl                    String?
  badgeToken                  String?    @unique
  companyIntegrationDate      DateTime?
  companyIntegrationExpiresAt DateTime?
  clientIntegrationDate       DateTime?
  clientIntegrationExpiresAt  DateTime?
  isActive                    Boolean    @default(true)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  user      User?
  Checklist Checklist[]
  trainings EmployeeTraining[]
  units     EmployeeUnit[]

  @@index([tenantId, isActive])
  @@index([tenantId, matricula])
  @@index([supervisorId])
}

model EmployeeTraining {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  completedAt DateTime
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, expiresAt])
}

// ---------------------------------------------------------
// ORGANIZATIONAL STRUCTURE
// ---------------------------------------------------------

/// Frente de trabalho / contrato. Cada frota pertence a uma frente; gestores, supervisores e
/// motoristas só enxergam as frentes em que estão vinculados (o administrador da empresa vê todas).
model Unit {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  // Cliente do contrato (ex.: a contratante). Opcional.
  client    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fleets    Fleet[]
  users     UserUnit[]
  employees EmployeeUnit[]
  templates TemplateUnit[]

  @@index([tenantId])
}

/// Frentes que um login do portal (gestor, supervisor) pode ver.
model UserUnit {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
}

/// Frentes em que um funcionário trabalha. O motorista do app vê os veículos e checklists delas.
model EmployeeUnit {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([employeeId, unitId])
  @@index([unitId])
}

/// Frentes em que um modelo de checklist vale (quando Template.allUnits é falso).
model TemplateUnit {
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([templateId, unitId])
  @@index([unitId])
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ---------------------------------------------------------
// FLEET MANAGEMENT
// ---------------------------------------------------------

model Fleet {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles Vehicle[]

  @@index([tenantId])
  @@index([unitId])
}

model Vehicle {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleetId   String
  fleet     Fleet           @relation(fields: [fleetId], references: [id])
  plate     String
  prefix    String?
  brand     String?
  model     String?
  year      Int?
  status    String          @default("LIBERADO") // LIBERADO, ATENCAO, BLOQUEADO
  // Maior km informado nas inspeções (hodômetro).
  mileage   Int             @default(0)
  qrCode    String?         @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Checklist Checklist[]
  ncs       NonConformity[]

  @@unique([tenantId, plate])
  @@index([tenantId, isActive, status])
  @@index([fleetId])
}

// ---------------------------------------------------------
// DYNAMIC CHECKLISTS & INSPECTIONS
// ---------------------------------------------------------

model Template {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  // Sobe a cada mudança em seções ou itens; o app envia a versão que usou no checklist
  version     Int      @default(1)
  // Vale em todas as frentes de trabalho. Falso: só nas frentes de TemplateUnit.
  allUnits    Boolean  @default(true)
  // Pede o km do veículo (hodômetro) no checklist do app; obrigatório no app quando ligado.
  askOdometer Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories TemplateCategory[]
  checklists Checklist[]
  units      TemplateUnit[]

  @@index([tenantId])
}

model TemplateCategory {
  id         String   @id @default(uuid())
  tenantId   String
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)
  // Seção removida que já tem respostas: fica oculta, mas preserva o histórico
  isActive   Boolean  @default(true)

  items TemplateItem[]

  @@index([templateId])
}

model TemplateItem {
  id               String           @id @default(uuid())
  tenantId         String
  categoryId       String
  category         TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  text             String
  type             String           @default("PASS_FAIL") // PASS_FAIL, TEXT, NUMBER, PHOTO
  isRequired       Boolean          @default(true)
  isCritical       Boolean          @default(false)
  // Evidência fotográfica: NONE, ON_NON_COMPLIANCE (só quando não conforme), ALWAYS
  photoRequirement String           @default("NONE")
  order            Int              @default(0)
  // Item removido que já tem respostas: fica oculto, mas preserva o histórico
  isActive         Boolean          @default(true)
  // Versão do modelo em que o item entrou (checklists de versões anteriores não precisam respondê-lo)
  addedInVersion   Int              @default(1)

  answers ChecklistAnswer[]
  ncs     NonConformity[]

  @@index([categoryId])
}

// A Execução de um Checklist (A inspeção em si preenchida pelo motorista)
model Checklist {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation("TenantToChecklist", fields: [tenantId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId   String
  driver     Employee @relation(fields: [driverId], references: [id])

  // UUID gerado no celular (idempotência do sync offline)
  clientId String?

  // Modelo como estava quando o checklist foi preenchido
  templateVersion Int?
  templateName    String?

  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, SYNCED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  syncedAt    DateTime?
  latitude    Float?
  longitude   Float?
  // Aparelho que enviou (auditoria do login sem senha do aplicativo)
  deviceInfo  String?
  // Assinatura do colaborador ao concluir (imagem no armazenamento, como as fotos) e o nome de quem assinou.
  // Opcional na API: inspeções antigas e as que ainda estão na fila de apps antigos não têm.
  signatureUrl String?
  signedName   String?
  // Km do veículo (hodômetro) informado na inspeção. Vazio em inspeções antigas ou de modelo que não pede.
  odometerKm   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ChecklistAnswer[]

  @@unique([tenantId, clientId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, completedAt])
  @@index([tenantId, startedAt])
  @@index([driverId])
  @@index([templateId])
}

model ChecklistAnswer {
  id          String       @id @default(uuid())
  tenantId    String
  checklistId String
  checklist   Checklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemId      String
  item        TemplateItem @relation(fields: [itemId], references: [id])

  isCompliant   Boolean // true = Conforme, false = Não Conforme (N/A é gravado como true: não abre NC)
  // "Não se aplica": o item não existe neste veículo. Não conta como conforme nem como não conforme.
  notApplicable Boolean @default(false)
  textValue     String?
  numberValue   Float?
  photoUrl      String?
  observations  String?

  // Cópia da pergunta no momento da resposta: editar o modelo não altera o histórico
  itemText       String?
  itemType       String?
  itemIsCritical Boolean?
  categoryName   String?

  // NC aberta a partir desta resposta (primeira ocorrência)
  nonConformity NonConformity? @relation("NcOrigin")
  // NC já ativa à qual esta resposta foi agrupada (reincidência)
  recurrentNcId String?
  recurrentNc   NonConformity? @relation("NcRecurrence", fields: [recurrentNcId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([checklistId, itemId])
  // Itens não conformes de cada inspeção (lista de inspeções e relatório do painel) sem ler as respostas.
  @@index([checklistId, isCompliant])
  @@index([recurrentNcId])
  @@index([itemId])
}

model NonConformity {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation("TenantToNC", fields: [tenantId], references: [id], onDelete: Cascade)
  answerId  String          @unique
  answer    ChecklistAnswer @relation("NcOrigin", fields: [answerId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  itemId    String?
  item      TemplateItem?   @relation(fields: [itemId], references: [id])

  status           String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  severity         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  notes            String?
  occurrences      Int       @default(1)
  lastOccurrenceAt DateTime?
  resolvedAt       DateTime?

  recurrences ChecklistAnswer[] @relation("NcRecurrence")
  actions     NcAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, vehicleId, itemId, status])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([vehicleId])
  @@index([itemId])
}

/// Tratativa de uma NC: cada registro é uma ação (comentário, mudança de situação), com fotos.
model NcAction {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ncId       String
  nc         NonConformity @relation(fields: [ncId], references: [id], onDelete: Cascade)
  // Quem fez (o nome fica copiado: continua no histórico mesmo se o login for removido).
  userId     String?
  userName   String
  fromStatus String?
  toStatus   String?
  text       String?
  // Até 3 fotos da tratativa (endereço do armazenamento, como nas inspeções).
  photoUrls  String[]
  createdAt  DateTime      @default(now())

  @@index([tenantId, ncId, createdAt])
}
