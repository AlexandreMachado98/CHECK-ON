generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: URL com pooling (-pooler no host) para a API
  url       = env("DATABASE_URL")
  // Neon: URL direta, usada pelo prisma migrate
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// TENANT MANAGEMENT
// ---------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  name        String
  cnpj        String?  @unique
  isActive    Boolean  @default(true)
  plan        String   @default("STARTER") // STARTER, PRO, ENTERPRISE
  storageUsed BigInt   @default(0) // in bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  employees   Employee[]
  roles       Role[]
  departments Department[]
  units       Unit[]
  fleets      Fleet[]
  vehicles    Vehicle[]
  checklists  Checklist[]     @relation("TenantToChecklist")
  templates   Template[]
  ncs         NonConformity[] @relation("TenantToNC")
}

// ---------------------------------------------------------
// USERS AND RBAC
// ---------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  permissions String // e.g. ["checklist:create", "vehicle:read"]
  isSystem    Boolean  @default(false) // Super admin roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
}

// Sessões de longa duração (app mobile offline). Guarda só o hash SHA-256 do token.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Tokens renovados a partir do mesmo login compartilham a família (detecção de reuso)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Employee {
  id                          String     @id @default(uuid())
  tenantId                    String
  tenant                      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matricula                   String?
  name                        String
  jobTitle                    String?
  admissionDate               DateTime?
  departmentName              String?
  supervisorId                String?
  supervisor                  Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports               Employee[] @relation("EmployeeSupervisor")
  photoUrl                    String?
  badgeToken                  String?    @unique
  companyIntegrationDate      DateTime?
  companyIntegrationExpiresAt DateTime?
  clientIntegrationDate       DateTime?
  clientIntegrationExpiresAt  DateTime?
  isActive                    Boolean    @default(true)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  user      User?
  Checklist Checklist[]
  trainings EmployeeTraining[]

  @@index([tenantId, isActive])
  @@index([tenantId, matricula])
  @@index([supervisorId])
}

model EmployeeTraining {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  completedAt DateTime
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, expiresAt])
}

// ---------------------------------------------------------
// ORGANIZATIONAL STRUCTURE
// ---------------------------------------------------------

model Unit {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fleets Fleet[]

  @@index([tenantId])
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ---------------------------------------------------------
// FLEET MANAGEMENT
// ---------------------------------------------------------

model Fleet {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]

  @@index([tenantId])
  @@index([unitId])
}

model Vehicle {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fleetId   String
  fleet     Fleet           @relation(fields: [fleetId], references: [id])
  plate     String
  prefix    String?
  brand     String?
  model     String?
  year      Int?
  status    String          @default("LIBERADO") // LIBERADO, ATENCAO, BLOQUEADO
  mileage   Int             @default(0)
  qrCode    String?         @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Checklist Checklist[]
  ncs       NonConformity[]

  @@unique([tenantId, plate])
  @@index([tenantId, isActive, status])
  @@index([fleetId])
}

// ---------------------------------------------------------
// DYNAMIC CHECKLISTS & INSPECTIONS
// ---------------------------------------------------------

model Template {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  // Sobe a cada mudança em seções ou itens; o app envia a versão que usou no checklist
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories TemplateCategory[]
  checklists Checklist[]

  @@index([tenantId])
}

model TemplateCategory {
  id         String   @id @default(uuid())
  tenantId   String
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)
  // Seção removida que já tem respostas: fica oculta, mas preserva o histórico
  isActive   Boolean  @default(true)

  items TemplateItem[]

  @@index([templateId])
}

model TemplateItem {
  id               String           @id @default(uuid())
  tenantId         String
  categoryId       String
  category         TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  text             String
  type             String           @default("PASS_FAIL") // PASS_FAIL, TEXT, NUMBER, PHOTO
  isRequired       Boolean          @default(true)
  isCritical       Boolean          @default(false)
  // Evidência fotográfica: NONE, ON_NON_COMPLIANCE (só quando não conforme), ALWAYS
  photoRequirement String           @default("NONE")
  order            Int              @default(0)
  // Item removido que já tem respostas: fica oculto, mas preserva o histórico
  isActive         Boolean          @default(true)
  // Versão do modelo em que o item entrou (checklists de versões anteriores não precisam respondê-lo)
  addedInVersion   Int              @default(1)

  answers ChecklistAnswer[]
  ncs     NonConformity[]

  @@index([categoryId])
}

// A Execução de um Checklist (A inspeção em si preenchida pelo motorista)
model Checklist {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation("TenantToChecklist", fields: [tenantId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId   String
  driver     Employee @relation(fields: [driverId], references: [id])

  // UUID gerado no celular (idempotência do sync offline)
  clientId String?

  // Modelo como estava quando o checklist foi preenchido
  templateVersion Int?
  templateName    String?

  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, SYNCED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  syncedAt    DateTime?
  latitude    Float?
  longitude   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ChecklistAnswer[]

  @@unique([tenantId, clientId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, completedAt])
  @@index([tenantId, startedAt])
  @@index([driverId])
  @@index([templateId])
}

model ChecklistAnswer {
  id          String       @id @default(uuid())
  tenantId    String
  checklistId String
  checklist   Checklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemId      String
  item        TemplateItem @relation(fields: [itemId], references: [id])

  isCompliant  Boolean // true = Conforme, false = Não Conforme
  textValue    String?
  numberValue  Float?
  photoUrl     String?
  observations String?

  // Cópia da pergunta no momento da resposta: editar o modelo não altera o histórico
  itemText       String?
  itemType       String?
  itemIsCritical Boolean?
  categoryName   String?

  // NC aberta a partir desta resposta (primeira ocorrência)
  nonConformity NonConformity? @relation("NcOrigin")
  // NC já ativa à qual esta resposta foi agrupada (reincidência)
  recurrentNcId String?
  recurrentNc   NonConformity? @relation("NcRecurrence", fields: [recurrentNcId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([checklistId, itemId])
  @@index([recurrentNcId])
  @@index([itemId])
}

model NonConformity {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation("TenantToNC", fields: [tenantId], references: [id], onDelete: Cascade)
  answerId  String          @unique
  answer    ChecklistAnswer @relation("NcOrigin", fields: [answerId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  itemId    String?
  item      TemplateItem?   @relation(fields: [itemId], references: [id])

  status           String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  severity         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  notes            String?
  occurrences      Int       @default(1)
  lastOccurrenceAt DateTime?
  resolvedAt       DateTime?

  recurrences ChecklistAnswer[] @relation("NcRecurrence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, vehicleId, itemId, status])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([vehicleId])
  @@index([itemId])
}
