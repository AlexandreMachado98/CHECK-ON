<?xml version="1.0" encoding="utf-8"?>
<!-- Conceito B: arco de painel (letra C de CHECK-ON) com o check no centro. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Trilho do arco (parte apagada do medidor). -->
    <path
        android:pathData="M73.2,37.4 A26,26 0 1 0 73.2,70.6"
        android:strokeColor="#FF1E293B"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Progresso verde (ponteiro no verde). -->
    <path
        android:pathData="M73.2,37.4 A26,26 0 1 0 45.45,78.57"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="73" android:startY="30"
                android:endX="38" android:endY="80">
                <item android:offset="0" android:color="#FF34D399" />
                <item android:offset="1" android:color="#FF059669" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ponto inicial do medidor. -->
    <path
        android:pathData="M73.2,37.4 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0"
        android:fillColor="#FFA7F3D0" />

    <!-- Check branco. -->
    <path
        android:pathData="M43,55 L51,63 L66,47"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
