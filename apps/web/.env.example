# Na Vercel, cadastre em Settings > Environment Variables.

# Endereço da API (sem barra no final).
# Na Vercel com services, deixe VAZIO: o painel usa /api na mesma origem.
# Com `next dev` isolado, aponte para a API local: http://localhost:3333
# Com a API hospedada fora da Vercel (ex.: Render), use o endereço dela.
NEXT_PUBLIC_API_URL=

# Endereço público do próprio painel (usado nos QR Codes dos crachás).
# Se vazio, usa o domínio aberto no navegador.
NEXT_PUBLIC_APP_URL=
