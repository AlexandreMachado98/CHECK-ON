{
  "expo": {
    "name": "CHECK-ON",
    "slug": "checkon-app",
    "scheme": "checkon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.checkon.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.checkon.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O CHECK-ON usa a câmera para ler o QR Code do veículo e fotografar os itens da inspeção.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O CHECK-ON usa a câmera para fotografar os itens da inspeção.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CHECK-ON registra o local onde a inspeção foi feita."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "apiUrl": "https://check-on-mu.vercel.app/api"
    }
  }
}
