{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "buildCommand": "if [ \"$VERCEL_ENV\" != \"preview\" ] && [ -n \"$DIRECT_URL\" ]; then npx prisma migrate deploy; else echo \"prisma migrate deploy pulado (VERCEL_ENV=$VERCEL_ENV)\"; fi && npm run build"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
